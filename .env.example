# This file documents safe steady-state keys only. kwork-mcp never loads .env.
# NEVER put KWORK_TOKEN, KWORK_LOGIN, KWORK_PASSWORD, KWORK_PHONE_LAST or
# KWORK_PROXY_URL in Codex/Claude MCP config, .env, argv, or a launcher command.
# Run `KWORK_EXPECTED_USER_ID=123456 kwork-mcp-bootstrap` once in a real TTY;
# it prompts privately and stores the verified token/optional proxy under 0600.

# Required for every normal MCP server launch.
KWORK_EXPECTED_USER_ID=123456
# KWORK_EXPECTED_USERNAME=expected_username
KWORK_PERSIST_TOKEN=true

# Enable only after account_status confirms the expected account.
KWORK_ENABLE_WRITES=false

# Private shared state for processes serving the same account.
# KWORK_STATE_DIR=/absolute/private/path/kwork-mcp

# Proxy URL is bootstrap-only and is persisted in the protected account record.
# Re-run bootstrap to add, replace, or remove it.
# KWORK_TIMEOUT=30

# Shared account/endpoint throttling and circuit behavior.
# KWORK_RPS_LIMIT=2
# KWORK_BURST_LIMIT=4
# KWORK_ROUTE_RPS_LIMIT=1
# KWORK_ROUTE_BURST_LIMIT=2
# KWORK_RATE_WAIT_TIMEOUT=20
# KWORK_AUTH_LOCK_TIMEOUT=90
# KWORK_READ_ATTEMPTS=3
# KWORK_RETRY_BACKOFF_BASE=0.5
# KWORK_RETRY_BACKOFF_MAX=8
# KWORK_CIRCUIT_FAILURE_THRESHOLD=3
# KWORK_CIRCUIT_OPEN_SECONDS=30

# Durable write and reconciliation safety.
# KWORK_PREPARATION_TTL_SECONDS=600
# KWORK_WRITE_LEASE_SECONDS=120
# KWORK_RECONCILIATION_MIN_AGE_SECONDS=15
# KWORK_RECONCILIATION_ABSENCE_CONFIRMATIONS=2
# KWORK_RECONCILIATION_ABSENCE_INTERVAL_SECONDS=15
# KWORK_STATE_RETENTION_DAYS=30

# KWORK_LOG_LEVEL=INFO
